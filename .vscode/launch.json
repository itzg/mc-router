{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch mc-router",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/mc-router",
            "env": {
                "IN_DOCKER": "true"
            }
        },
        {
            "name": "Launch mc-router, auto-scale",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/mc-router",
            "env": {
                "IN_DOCKER": "true",
                "AUTO_SCALE_DOWN": "true",
                "AUTO_SCALE_DOWN_AFTER": "1m",
                "AUTO_SCALE_UP": "true",
                "AUTO_SCALE_ASLEEP_MOTD": "Server is asleep. Join again to wake it up!"
            }
        },
        {
            "name": "Launch mc-router, auto-scale, with wake kick",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/mc-router",
            "env": {
                "IN_DOCKER": "true",
                "AUTO_SCALE_DOWN": "true",
                "AUTO_SCALE_DOWN_AFTER": "1m",
                "AUTO_SCALE_UP": "true",
                "AUTO_SCALE_ASLEEP_MOTD": "Server is asleep. Join again to wake it up!",
                "AUTO_SCALE_WAKE_KICK_MESSAGE": "Server is waking up. Please rejoin in a few seconds."
            }
        }
    ]
}